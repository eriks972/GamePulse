# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw datasets
/backend/GamePulse.Api/Data/raw/
/data/raw/

# .NET build output
**/bin/
**/obj/
**/publish/

# Frontend dependencies and build output
**/node_modules/
**/.next/
# GamePulse generated Python files and incomplete MLB imports
__pycache__/
*.py[cod]
backend/GamePulse.Api/Data/processed/mlb/building-*/
backend/GamePulse.Api/Data/processed/mlb/.import.lock
