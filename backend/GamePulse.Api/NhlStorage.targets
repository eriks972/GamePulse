<Project>
  <!-- Publish compressed data only from the authoritative current run for each season. -->
  <Target Name="SelectActiveNhlSnapshots" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_NhlCurrent Include="Data/processed/nhl/seasons/*/current.json" />
      <_NhlCurrent Update="@(_NhlCurrent)" Condition="'@(_NhlCurrent)' != ''">
        <RunId>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(FullPath)')), '(?s)^.*?&quot;runId&quot;\s*:\s*&quot;([0-9]{8}T[0-9]{6}-[a-f0-9]{8})&quot;.*$', '$1'))</RunId>
      </_NhlCurrent>
      <_NhlCurrent Update="@(_NhlCurrent)" Condition="'@(_NhlCurrent)' != ''">
        <RunDirectory>%(RelativeDir)runs/%(RunId)</RunDirectory>
      </_NhlCurrent>
    </ItemGroup>
    <Error Condition="'@(_NhlCurrent)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('%(_NhlCurrent.RunId)', '^[0-9]{8}T[0-9]{6}-[a-f0-9]{8}$'))" Text="Invalid NFL current manifest: %(_NhlCurrent.Identity)" />
    <Error Condition="'@(_NhlCurrent)' != '' And !Exists('%(_NhlCurrent.RunDirectory)/season.json.gz')" Text="NFL current run is missing season.json.gz: %(_NhlCurrent.Identity)" />
    <ItemGroup>
      <Content Remove="Data/processed/nhl/**/*" />
      <None Remove="Data/processed/nhl/**/*" />
      <Content Include="Data/processed/nhl/seasons.json" Condition="Exists('Data/processed/nhl/seasons.json')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="@(_NhlCurrent)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Include="%(_NhlCurrent.RunDirectory)/*.json.gz" Condition="'@(_NhlCurrent)' != ''">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
  <Target Name="ClearGeneratedNhlCopies" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' != '' and '$(TargetFramework)' != ''">
    <ItemGroup>
      <_NhlGenerated Include="$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/Data/processed/nhl/**/*" />
    </ItemGroup>
    <Delete Files="@(_NhlGenerated)" />
  </Target>
</Project>
